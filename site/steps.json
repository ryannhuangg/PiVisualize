    "description": "Start from the tangent line and solve for where it crosses the x-axis.",
    "steps": [
      {
        "t": 0,
        "label": "Tangent line at xₙ",
        "values": ["y - f(x_n) = f'(x_n)(x - x_n)", "Point-slope form of the tangent at xₙ"]
      },
      {
        "t": 3,
        "label": "Set y = 0 and x = xₙ₊₁",
        "values": ["0 - f(x_n) = f'(x_n)(x_{n+1} - x_n)", "The next guess is where the tangent crosses the x-axis"]
      },
      {
        "t": 5,
        "label": "Divide by f′(xₙ)",
        "values": ["-\\frac{f(x_n)}{f'(x_n)} = x_{n+1} - x_n", "Divide both sides by f′(xₙ)"]
      },
      {
        "t": 7,
        "label": "Add xₙ to both sides",
        "values": ["x_{n+1} = x_n - \\frac{f(x_n)}{f'(x_n)}", "Add xₙ to both sides to get Newton's update rule"]
      }
    ]
  }
