  "newton-derivation": {
    "group": "newton-derivation",
    "title": "Newton's Method: Derivation",
    "video": "videos/NewtonDerivation.mp4",
    "cards": [
      {
        "label": "Equation",
        "math": true
      },
      {
        "label": "Operation",
        "math": false
      }
    ],
    "legend": [],
    "steps": [
      {
        "t": 0,
        "label": "Tangent line at xₙ",
        "values": [
          "y - f(x_n) = f'(x_n)(x - x_n)",
          "Point-slope form of the tangent at xₙ"
        ]
      },
      {
        "t": 3,
        "label": "Set y = 0 and x = xₙ₊₁",
        "values": [
          "0 - f(x_n) = f'(x_n)(x_{n+1} - x_n)",
          "The next guess is where the tangent crosses the x-axis"
        ]
      },
      {
        "t": 5,
        "label": "Divide by f′(xₙ)",
        "values": [
          "-\\frac{f(x_n)}{f'(x_n)} = x_{n+1} - x_n",
          "Divide both sides by f′(xₙ)"
        ]
      },
      {
        "t": 7,
        "label": "Add xₙ to both sides",
        "values": [
          "x_{n+1} = x_n - \\frac{f(x_n)}{f'(x_n)}",
          "Add xₙ to both sides to get Newton's update rule"
        ]
      }
    ],
    "discussion": {
      "title": "Newton's Method: Derivation",
      "subtitle": "Tangent Line to Update Rule",
      "text": "Start from the tangent line at $x_n$, ask where it hits $y = 0$, and solve for that $x$. The result is the update rule $x_{n+1} = x_n - \\frac{f(x_n)}{f'(x_n)}$."
    }
  }
